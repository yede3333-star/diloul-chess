# Copy to .env.local for local development (never commit real values).
# Public (they reach the browser by design; protected by RLS):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# "on" once Google sign-in is configured in Supabase (deferred computer task):
NEXT_PUBLIC_AUTH_GOOGLE=off
